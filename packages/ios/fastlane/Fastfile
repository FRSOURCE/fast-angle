# Deployed by .github/actions/deploy-to-app-store on pushes to main touching packages/ios.
# The Apple Distribution cert is installed into a temporary keychain by
# apple-actions/import-codesign-certs before this lane runs; the provisioning profile
# is fetched (and created/renewed when missing) by the lane itself via sigh.

default_platform(:ios)

BUNDLE_ID = "org.frsource.www.fast-angle".freeze

platform :ios do
  desc "Build a signed IPA, upload it and — unless a review is already in progress — submit it for App Store review"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY"),
      is_key_content_base64: false
    )

    # Apple requires monotonically increasing build numbers; asking App Store Connect
    # for the latest uploaded build avoids a commit-back step (unlike the Android flow,
    # which commits the bumped twa-manifest.json version code to main).
    build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      initial_build_number: 0
    ) + 1
    version = "1.#{build_number}"

    # Deletes stale non-ACTIVE profiles for this app that the ASC API can still see,
    # so they don't pile up or collide with profile names used below. NOTE: expired
    # profiles are invisible to the list API yet still count against name uniqueness
    # on creation — that residue is what the rescue fallback below handles.
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)
    Spaceship::ConnectAPI::Profile.all
      .select { |profile| profile.name.start_with?(BUNDLE_ID) && profile.profile_state != "ACTIVE" }
      .each do |profile|
        UI.message("Deleting stale provisioning profile '#{profile.name}' (#{profile.id}, state: #{profile.profile_state})")
        profile.delete!
      end

    # Reuses any valid App Store profile for the bundle id (whatever its name), and
    # creates one through the ASC API when none exists — so profile expiry (or a
    # missing profile) never breaks the pipeline. The exact name "org.frsource.www.
    # fast-angle" is unusable: hidden expired duplicates 409 every creation attempt.
    sigh_options = { api_key: api_key, app_identifier: BUNDLE_ID }
    begin
      get_provisioning_profile(provisioning_name: "#{BUNDLE_ID} CI", **sigh_options)
    rescue => e
      raise unless e.message.include?("Multiple profiles found with the name")
      UI.important("Profile name blocked by expired profiles hidden from the ASC API — retrying with a unique name")
      get_provisioning_profile(provisioning_name: "#{BUNDLE_ID} CI #{build_number}", **sigh_options)
    end
    profile_name = lane_context[SharedValues::SIGH_NAME]

    # The team id isn't committed in project.pbxproj; the freshly downloaded profile is
    # the source of truth for it.
    profile_path = lane_context[SharedValues::SIGH_PROFILE_PATH]
    team_id = sh("security cms -D -i '#{profile_path}' | plutil -extract 'TeamIdentifier.0' raw -o - -").strip

    # The committed project uses automatic signing with no team, which can't work on an
    # ephemeral CI runner — switch the app target (and only it, so CocoaPods targets are
    # untouched) to manual signing against the profile fetched above.
    update_code_signing_settings(
      path: "Fast Angle.xcodeproj",
      targets: ["Fast Angle"],
      use_automatic_signing: false,
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name
    )

    cocoapods(repo_update: true)

    build_app(
      workspace: "Fast Angle.xcworkspace",
      scheme: "Fast Angle",
      configuration: "Release",
      export_method: "app-store",
      # Info.plist reads CFBundleVersion/CFBundleShortVersionString from these build
      # settings, so overriding them here versions the build without touching the project.
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number} MARKETING_VERSION=#{version}",
      export_options: {
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: { BUNDLE_ID => profile_name }
      }
    )

    # Apple allows only one open review submission per app, and deliver aborts the
    # whole lane with "A review submission is already in progress" rather than
    # queueing behind it — so a version left waiting for (or in) review by an earlier
    # push would fail every later one. Uploading the build is still worth doing, so
    # ask for review only when the way is clear and report back when it isn't.
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    pending_review = app.get_in_progress_review_submission(platform: Spaceship::ConnectAPI::Platform::IOS)

    upload_to_app_store(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      app_version: version,
      # Existing store metadata and screenshots carry over from the previous version;
      # only the required "What's New" text is provided per release. The explicit
      # "en-US" entry is required — deliver detects which locales to touch from real
      # locale keys, so a "default"-only hash uploads nothing.
      skip_metadata: false,
      skip_screenshots: true,
      release_notes: {
        "default" => "Stability and performance improvements.",
        "en-US" => "Stability and performance improvements."
      },
      # Answers for the age-rating questions Apple added in 2025 (parentalControls,
      # lootBox, ageAssurance, ...) — the app's existing declaration predates them and
      # review submission rejects the version until they are all filled in.
      app_rating_config_path: "./fastlane/rating_config.json",
      # Year of the repository's first commit, matching LICENSE. Apple's precheck
      # flags a copyright notice without a year as a potential review problem.
      copyright: "2022 FRSOURCE",
      submit_for_review: pending_review.nil?,
      automatic_release: true,
      precheck_include_in_app_purchases: false,
      force: true, # skip the interactive HTML metadata-report approval
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false
      }
    )

    next unless pending_review

    report_review_not_submitted(version: version, build_number: build_number, state: pending_review.state)
  end

  # The upload half succeeded but nobody asked Apple to review it, which is easy to
  # miss in a green run — so say it in the fastlane log, as a run annotation, and in
  # the job summary.
  private_lane :report_review_not_submitted do |options|
    message = "iOS #{options[:version]} (build #{options[:build_number]}) was uploaded to App Store Connect " \
              "but NOT submitted for review: the previous submission is still #{options[:state]}. " \
              "What to do now: wait for it to finish (or cancel it) in App Store Connect, then either submit " \
              "#{options[:version]} for review from the website, or re-run this workflow to upload and submit a fresh build."

    UI.important(message)

    if ENV["GITHUB_ACTIONS"]
      puts("::warning title=App Store review not submitted::#{message}")
      summary_path = ENV["GITHUB_STEP_SUMMARY"]
      File.write(summary_path, "### ⚠️ App Store review not submitted\n\n#{message}\n", mode: "a") if summary_path
    end
  end
end
