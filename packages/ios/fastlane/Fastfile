# Deployed by .github/actions/deploy-to-app-store on pushes to main touching packages/ios.
# The Apple Distribution cert is installed into a temporary keychain by
# apple-actions/import-codesign-certs before this lane runs; the provisioning profile
# is fetched (and created/renewed when missing) by the lane itself via sigh.

default_platform(:ios)

BUNDLE_ID = "org.frsource.www.fast-angle".freeze

platform :ios do
  desc "Build a signed IPA, upload it and submit the new version for App Store review"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY"),
      is_key_content_base64: false
    )

    # Apple requires monotonically increasing build numbers; asking App Store Connect
    # for the latest uploaded build avoids a commit-back step (unlike the Android flow,
    # which commits the bumped twa-manifest.json version code to main).
    build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      initial_build_number: 0
    ) + 1
    version = "1.#{build_number}"

    # Deletes stale non-ACTIVE profiles for this app that the ASC API can still see,
    # so they don't pile up or collide with profile names used below. NOTE: expired
    # profiles are invisible to the list API yet still count against name uniqueness
    # on creation — that residue is what the rescue fallback below handles.
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)
    Spaceship::ConnectAPI::Profile.all
      .select { |profile| profile.name.start_with?(BUNDLE_ID) && profile.profile_state != "ACTIVE" }
      .each do |profile|
        UI.message("Deleting stale provisioning profile '#{profile.name}' (#{profile.id}, state: #{profile.profile_state})")
        profile.delete!
      end

    # Reuses any valid App Store profile for the bundle id (whatever its name), and
    # creates one through the ASC API when none exists — so profile expiry (or a
    # missing profile) never breaks the pipeline. The exact name "org.frsource.www.
    # fast-angle" is unusable: hidden expired duplicates 409 every creation attempt.
    sigh_options = { api_key: api_key, app_identifier: BUNDLE_ID }
    begin
      get_provisioning_profile(provisioning_name: "#{BUNDLE_ID} CI", **sigh_options)
    rescue => e
      raise unless e.message.include?("Multiple profiles found with the name")
      UI.important("Profile name blocked by expired profiles hidden from the ASC API — retrying with a unique name")
      get_provisioning_profile(provisioning_name: "#{BUNDLE_ID} CI #{build_number}", **sigh_options)
    end
    profile_name = lane_context[SharedValues::SIGH_NAME]

    # The team id isn't committed in project.pbxproj; the freshly downloaded profile is
    # the source of truth for it.
    profile_path = lane_context[SharedValues::SIGH_PROFILE_PATH]
    team_id = sh("security cms -D -i '#{profile_path}' | plutil -extract 'TeamIdentifier.0' raw -o - -").strip

    # The committed project uses automatic signing with no team, which can't work on an
    # ephemeral CI runner — switch the app target (and only it, so CocoaPods targets are
    # untouched) to manual signing against the profile fetched above.
    update_code_signing_settings(
      path: "Fast Angle.xcodeproj",
      targets: ["Fast Angle"],
      use_automatic_signing: false,
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name
    )

    cocoapods(repo_update: true)

    build_app(
      workspace: "Fast Angle.xcworkspace",
      scheme: "Fast Angle",
      configuration: "Release",
      export_method: "app-store",
      # Info.plist reads CFBundleVersion/CFBundleShortVersionString from these build
      # settings, so overriding them here versions the build without touching the project.
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number} MARKETING_VERSION=#{version}",
      export_options: {
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: { BUNDLE_ID => profile_name }
      }
    )

    upload_to_app_store(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      app_version: version,
      # Existing store metadata and screenshots carry over from the previous version;
      # only the required "What's New" text is provided per release.
      skip_metadata: false,
      skip_screenshots: true,
      release_notes: { "default" => "Stability and performance improvements." },
      submit_for_review: true,
      automatic_release: true,
      precheck_include_in_app_purchases: false,
      force: true, # skip the interactive HTML metadata-report approval
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false
      }
    )
  end
end
